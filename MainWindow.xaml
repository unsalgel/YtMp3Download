<Window x:Class="YoutubeMp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube MP3 İndirici"
        Height="660" Width="680"
        MinHeight="660" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        FontFamily="{StaticResource MainFont}"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <DropShadowEffect x:Key="TitleGlow" Color="#FF0000" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="24" ShadowDepth="2" Opacity="0.4"/>
    </Window.Resources>

    <Grid>
        <!-- Arka plan gradyanı -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D0A0A" Offset="0"/>
                <GradientStop Color="#140E0E" Offset="0.5"/>
                <GradientStop Color="#180808" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Dekoratif daire sol üst -->
        <Ellipse Width="320" Height="320"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-80,-80,0,0" Opacity="0.06">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF0000" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Dekoratif daire sağ alt -->
        <Ellipse Width="280" Height="280"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-60,-60" Opacity="0.05">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF4444" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- İçerik kartı -->
        <Border Margin="32,28,32,28"
                CornerRadius="24"
                Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1212" Offset="0"/>
                    <GradientStop Color="#151010" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4D2020" Offset="0"/>
                    <GradientStop Color="#3A1818" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1.5</Border.BorderThickness>

            <Grid Margin="36,28,36,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Başlık -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- URL -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- Klasör -->
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>  <!-- Buton -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- Progress -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- Durum -->
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>  <!-- Alt bilgi -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>  <!-- Geliştirici -->
                </Grid.RowDefinitions>

                <!-- ═══════════════ BAŞLIK ═══════════════ -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <!-- YouTube tarzı kırmızı ikon -->
                    <Border Width="64" Height="64"
                            CornerRadius="18"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC0000" Offset="0"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF0000" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <TextBlock Text="▶" FontSize="28" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="3,0,0,0"/>
                    </Border>

                    <TextBlock Text="YouTube MP3 İndirici"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Effect="{StaticResource TitleGlow}"/>

                    <TextBlock Text="YouTube videolarını kolayca MP3'e dönüştürün"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ═══════════════ URL GİRİŞ ═══════════════ -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="YouTube Linki" Grid.Row="0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="4,0,0,0"/>

                    <Grid Grid.Row="2">
                        <TextBox x:Name="UrlTextBox"
                                 Style="{StaticResource DarkInput}"
                                 FontSize="13"
                                 Height="46"
                                 VerticalContentAlignment="Center"
                                 AcceptsReturn="False"
                                 SpellCheck.IsEnabled="False"
                                 TextChanged="UrlTextBox_TextChanged"/>
                        <TextBlock x:Name="UrlPlaceholder"
                                   Text="🔗  https://www.youtube.com/watch?v=..."
                                   FontSize="13"
                                   Foreground="{StaticResource TextHint}"
                                   VerticalAlignment="Center"
                                   Margin="18,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- ═══════════════ KLASÖR SEÇİCİ ═══════════════ -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Kayıt Konumu" Grid.Row="0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="4,0,0,0"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource BgInput}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Height="42">
                            <TextBlock x:Name="FolderPathText"
                                       Text="📁  Masaüstü"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,14,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <Button Grid.Column="2"
                                x:Name="BrowseButton"
                                Content="📂  Değiştir"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,0"
                                Height="42"
                                Click="BrowseButton_Click"/>
                    </Grid>
                </Grid>

                <!-- ═══════════════ İNDİR BUTONU ═══════════════ -->
                <Button Grid.Row="6"
                        x:Name="DownloadButton"
                        Content="🎵  Müziği İndir"
                        Style="{StaticResource PrimaryButton}"
                        Height="52"
                        FontSize="17"
                        Padding="0"
                        Click="DownloadButton_Click"/>

                <!-- ═══════════════ PROGRESS ═══════════════ -->
                <Grid Grid.Row="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressLabel"
                                   Text="Hazır" Grid.Column="0"
                                   FontSize="11" Foreground="{StaticResource TextHint}"/>
                        <TextBlock x:Name="ProgressPercent"
                                   Text="" Grid.Column="1"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentSecondary}"/>
                    </Grid>

                    <ProgressBar x:Name="ProgressBar"
                                 Grid.Row="2"
                                 Style="{StaticResource GlowProgressBar}"
                                 Minimum="0" Maximum="100" Value="0"/>
                </Grid>

                <!-- ═══════════════ DURUM MESAJI ═══════════════ -->
                <Border Grid.Row="10"
                        x:Name="StatusBorder"
                        CornerRadius="10"
                        Padding="12,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusIcon"
                                   Grid.Column="0"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="2"
                                   FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ═══════════════ ALT BİLGİ ═══════════════ -->
                <TextBlock Grid.Row="12"
                           Text="MP3 · 320 kbps · Albüm kapağı ve metadata otomatik eklenir"
                           FontSize="10"
                           Foreground="{StaticResource TextHint}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>

                <!-- ═══════════════ GELİŞTİRİCİ ═══════════════ -->
                <TextBlock Grid.Row="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           FontSize="11"
                           Opacity="0.7">
                    <Run Text="Geliştirici: " Foreground="{StaticResource TextHint}"/>
                    <Run Text="Ünsal GEL" Foreground="{StaticResource AccentSecondary}" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
